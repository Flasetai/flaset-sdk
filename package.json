{
  "name": "flaset-sdk",
  "version": "1.0.0",
  "description": "The Flaset SDK: create, check and buy Flash Deals, a token for a payment in one atomic transaction, on Robinhood Chain, Base, BNB Chain and Ethereum.",
  "license": "MIT",
  "author": "Flaset",
  "homepage": "https://flaset.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flasetai/flaset-sdk.git"
  },
  "keywords": [
    "flaset",
    "flash-deals",
    "sdk",
    "eip-712",
    "viem",
    "sablier",
    "vesting"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./deals": {
      "import": {
        "types": "./dist/deals/index.d.ts",
        "default": "./dist/deals/index.js"
      },
      "require": {
        "types": "./dist/deals/index.d.cts",
        "default": "./dist/deals/index.cjs"
      }
    },
    "./deployments/*.json": "./deployments/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "deployments",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit",
    "test:fork": "vitest run test/fork",
    "abi:check": "node scripts/gen-abi.mjs --check",
    "prepublishOnly": "npm run abi:check && npm run typecheck && npm run lint && npm test && npm run build",
    "example": "tsx examples/fork-demo.ts"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@openzeppelin/merkle-tree": "1.0.8",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "viem": "2.58.4",
    "vitest": "5.1.1"
  }
}
